APP_ENV=development
APP_NAME=AI Resume Parser
API_V1_PREFIX=/api/v1
AUTO_CREATE_TABLES=true

# Logging (INFO keeps pdfminer/sqlalchemy noise down)
LOG_LEVEL=INFO

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP
OTP_SECRET=change-me-otp-hmac-secret
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# TOTP (optional channel). Leave empty to derive a key from SECRET_KEY.
TOTP_ISSUER=AIResumeParser
TOTP_ENCRYPTION_KEY=

# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://resume:resume@localhost:5432/resume_db

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Email OTP (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com

# WhatsApp OTP (Meta WhatsApp Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-token
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_VERIFICATION_REQUIRED=true
# Authentication templates have a "Copy code" button at index 0. Set -1 to omit.
WHATSAPP_OTP_BUTTON_INDEX=0

# CORS (comma separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
